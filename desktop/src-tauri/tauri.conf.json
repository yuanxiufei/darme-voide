{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DramaStudio",
  "mainBinaryName": "DramaStudio",
  "version": "0.1.0",
  "identifier": "com.darme.voide.desktop",
  "build": {
    "frontendDist": "../dist-frontend",
    "devUrl": "http://localhost:3014"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "短剧工坊",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http://127.0.0.1:* http://localhost:*; media-src 'self' data: blob: http://127.0.0.1:* http://localhost:*; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../dist-backend/backend-py": "backend-py"
    },
    "copyright": "",
    "category": "Productivity",
    "shortDescription": "短剧工坊桌面端",
    "longDescription": "短剧工坊：从剧本到成片的一体化创作工作台（桌面壳 + 本地 Python 服务）。",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "languages": ["SimpChinese", "English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}

#!/bin/sh
#
# 提交前自检（两道守卫 + 一道守卫自检）。三道守卫都已从 Node 迁移到 Python
# （2026-09-15，随 backend-py/app/scripts/ 一起收口）：
#   1) 改动 backend-py/app/skills/ 或 docs/ 时校验路径引用完整性，防止「改名 / 挪库」造成的静默断链。
#      → backend-py/app/scripts/check_skill_refs.py（基线见 backend-py/app/skills/README.md「十、改动 skills 后必跑的自检」）
#   2) 改动 .codebuddy/memory/ 时校验记忆层，防止 MEMORY.md 超 8k 被注入截断、
#      以及 INDEX.md 的 `@行号` 锚点指错位置。
#      → backend-py/app/scripts/check_memory.py（规则见脚本头）
#   3) 改动**守卫脚本自身**时跑守卫自检：守卫被改哑后基线仍会是绿的（真实仓库本就合规）
#      ⇒「不报错」≠「还能报错」，故此道只在守卫脚本被动时触发。
#      → backend-py/app/scripts/test_guards.py（用例数见脚本头，1 = 有用例失败）
#
# 启用（在仓库根目录执行一次，仓库不会自动生效）：
#     git config core.hooksPath .githooks
# 关闭：
#     git config --unset core.hooksPath
# 绕过（确知无碍时）：
#     git commit --no-verify
#
# 退出码 1 = 存在致命项，提交被阻止。任一道未跑（本次提交未触及）则跳过。
# 注意：POSIX 环境下需 `chmod +x .githooks/pre-commit`。

set -e

staged=$(git diff --cached --name-only --diff-filter=ACMRD)
rc=0

# ── Python 解释器解析 ────────────────────────────────────────────────
# 三道守卫**只用标准库**，故任何 python3 都可跑；优先用后端 venv（开发机上就是它在跑），
# 再退回 PATH 上的 python3/python，最后用 Windows 的 py 启动器。
PY=""
for cand in "backend-py/.venv/bin/python" "backend-py/.venv/Scripts/python.exe" python3 python; do
	if command -v "$cand" >/dev/null 2>&1; then
		PY="$cand"
		break
	fi
done
PYARG=""
if [ -z "$PY" ] && command -v py >/dev/null 2>&1; then
	PY="py"
	PYARG="-3"
fi

# ── 1) 技能库引用完整性（守卫自身被改动时也跑）──────────────────────────
# 注意：docs/ 也在列 —— skill 正文会引用 `docs/*.md`，改了/删了 docs 同样会断链。
# 另：技能库 2026-09-15 已从仓库根 skills/ 并入 backend-py/app/skills/，触发路径随之更新。
if printf '%s\n' "$staged" | grep -qE '^backend-py/app/skills/|^docs/|^backend-py/app/scripts/check_skill_refs\.py$'; then
	printf '%s\n' '[pre-commit] backend-py/app/skills/ 或 docs/ 有改动，校验路径引用完整性...'
	if [ -z "$PY" ]; then
		printf '%s\n' '[pre-commit] FAIL: 找不到 python 解释器，无法跑引用守卫（装了 python3 后重试）。' >&2
		rc=1
	elif ! $PY $PYARG backend-py/app/scripts/check_skill_refs.py; then
		printf '%s\n' '[pre-commit] FAIL: 存在致命断链，提交已阻止。' >&2
		printf '%s\n' '            修复后重试；确认无碍可用 git commit --no-verify 绕过。' >&2
		rc=1
	fi
fi

# ── 2) 记忆层（8k 预算 + INDEX 锚点）──────────────────────────────────
if printf '%s\n' "$staged" | grep -qE '^\.codebuddy/memory/|^backend-py/app/scripts/check_memory\.py$'; then
	printf '%s\n' '[pre-commit] .codebuddy/memory/ 有改动，校验记忆层（8k 预算 + INDEX 锚点）...'
	if [ -z "$PY" ]; then
		printf '%s\n' '[pre-commit] FAIL: 找不到 python 解释器，无法跑记忆守卫（装了 python3 后重试）。' >&2
		rc=1
	elif ! $PY $PYARG backend-py/app/scripts/check_memory.py; then
		printf '%s\n' '[pre-commit] FAIL: 记忆层自检未通过，提交已阻止。' >&2
		printf '%s\n' '            修复后重试；确认无碍可用 git commit --no-verify 绕过。' >&2
		rc=1
	fi
fi

# ── 3) 守卫自检（守卫脚本本身被改动时）──────────────────────────────────
# 注意：第 2 道在守卫被改哑时**依然是绿的**，所以必须靠这一道兜住。
# 三个守卫脚本都要触发：早先漏了 check_skill_refs ⇒ 改它时自检根本不跑（改哑也无人拦）。
if printf '%s\n' "$staged" | grep -qE '^backend-py/app/scripts/(check_memory|check_skill_refs|test_guards)\.py$'; then
	printf '%s\n' '[pre-commit] 守卫脚本有改动，跑守卫自检（临时副本上造故障）...'
	if [ -z "$PY" ]; then
		printf '%s\n' '[pre-commit] FAIL: 找不到 python 解释器，无法跑守卫自检（装了 python3 后重试）。' >&2
		rc=1
	elif ! $PY $PYARG backend-py/app/scripts/test_guards.py; then
		printf '%s\n' '[pre-commit] FAIL: 守卫自检未通过（某个检查已失效），提交已阻止。' >&2
		printf '%s\n' '            修复后重试；确认无碍可用 git commit --no-verify 绕过。' >&2
		rc=1
	fi
fi

exit $rc
